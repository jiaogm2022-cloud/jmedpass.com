{
  "cleanUrls": false,
  "trailingSlash": false,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.jmedpass.com" }
      ],
      "destination": "https://jmedpass.com/$1",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zaisheng",
      "destination": "/regenerative-medicine",
      "permanent": true
    },
    {
      "source": "/mianyi",
      "destination": "/immunotherapy",
      "permanent": true
    },
    {
      "source": "/ganxibao-kangshuai",
      "destination": "/stem-cell-anti-aging",
      "permanent": true
    },
    {
      "source": "/ganxibao-luanchao",
      "destination": "/ovarian-rejuvenation",
      "permanent": true
    },
    {
      "source": "/meimei",
      "destination": "/cosmetic-surgery",
      "permanent": true
    },
    {
      "source": "/tijian",
      "destination": "/health-screening",
      "permanent": true
    },
    {
      "source": "/shenghuo",
      "destination": "/wellness",
      "permanent": true
    },
    {
      "source": "/zaixian",
      "destination": "/online-consultation",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/api/admin-login", "destination": "/api/admin?action=login" },
    { "source": "/api/admin-logout", "destination": "/api/admin?action=logout" },
    { "source": "/api/admin-session", "destination": "/api/admin?action=session" },
    { "source": "/api/admin-data", "destination": "/api/admin?action=data" },
    { "source": "/api/partner-login", "destination": "/api/partner-auth?action=login" },
    { "source": "/api/partner-logout", "destination": "/api/partner-auth?action=logout" },
    { "source": "/api/partner-register", "destination": "/api/partner-auth?action=register" },
    { "source": "/api/partner-session", "destination": "/api/partner-auth?action=session" },
    { "source": "/api/referral-token", "destination": "/api/partner-auth?action=referral-token" },
    { "source": "/api/partner-dashboard", "destination": "/api/partner?action=dashboard" },
    { "source": "/api/partner-withdrawals", "destination": "/api/partner?action=withdrawals" },
    { "source": "/api/public-products", "destination": "/api/partner?action=public-products" },
    { "source": "/api/create-checkout", "destination": "/api/commerce?action=create-checkout" },
    { "source": "/api/checkout-session-status", "destination": "/api/commerce?action=checkout-session-status" },
    { "source": "/api/get-order", "destination": "/api/commerce?action=get-order" },
    { "source": "/api/inquiries", "destination": "/api/submissions?action=inquiries" },
    { "source": "/api/consultations", "destination": "/api/submissions?action=consultations" },
    { "source": "/((?!api/|admin/|.*\\..*).+)", "destination": "/$1.html" },
    { "source": "/.netlify/functions/create-checkout", "destination": "/api/commerce?action=create-checkout" },
    { "source": "/.netlify/functions/get-order", "destination": "/api/commerce?action=get-order" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/i18n.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(login|my|success|404)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    }
  ]
}
