# ===== jmedpass.com 环境变量 =====
# 复制此文件为 .env 并填入实际值
# Vercel 部署时在 Dashboard → Settings → Environment Variables 中配置

# ── Stripe 支付 ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx          # Stripe 密钥（测试/生产）
STRIPE_WEBHOOK_SECRET=whsec_xxx        # Stripe Webhook 签名密钥

# ── 管理员认证 ───────────────────────────────────────
ADMIN_USERNAME=admin                   # 后台管理员用户名
ADMIN_PASSWORD_HASH=                   # 用 scrypt 格式的密码哈希（运行 node scripts/hash-password.js 生成）
ADMIN_SESSION_SECRET=                  # 随机强密钥（至少32字符），用于签名 admin session cookie
                                       # 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── 合伙人认证 ───────────────────────────────────────
PARTNER_SESSION_SECRET=                # 随机强密钥（至少32字符），用于签名 partner session cookie
                                       # 可与 ADMIN_SESSION_SECRET 不同，建议独立设置

# ── 数据库（迁移云数据库后替换） ─────────────────────
# JMEDPASS_DB_PATH=                    # 仅 SQLite 模式使用，迁移后删除
# DATABASE_URL=                        # 云数据库连接字符串（Neon/Supabase/Turso）

# ── 汇率 ─────────────────────────────────────────────
JPY_TO_SGD_RATE=0.00896                # 日元→新加坡元汇率，定期更新

# ── 运行环境 ─────────────────────────────────────────
NODE_ENV=production                    # Vercel 自动设置，本地开发用 development
